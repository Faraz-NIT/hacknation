# Copy to api/.env  (loaded automatically on startup). Every key is optional:
# with none set, SkyMentor runs fully offline with the simulated voice agent.

# --- ElevenLabs (voice agent) -------------------------------------------------
ELEVENLABS_API_KEY=            # needed for private agents (signed URL); never sent to the browser
ELEVENLABS_AGENT_ID=           # one agent for both roles (prompts sent as overrides)
# ELEVENLABS_AGENT_ID_EXPERT=  # optional: separate interviewer agent
# ELEVENLABS_AGENT_ID_TRAINEE= # optional: separate tutor agent

# --- Rule extraction (optional; heuristic extractor is the fallback) ------------
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Live data (optional; fixtures + cache are the fallback) ------------------
AVIATIONSTACK_KEY=             # free plan: HTTP only, 100 req/month, non-commercial
# AVIATIONSTACK_BASE=http://api.aviationstack.com/v1
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_FLIGHTS_DATASET_ID= # your Google Flights dataset/scraper id
# BRIGHTDATA_FLIGHTS_INPUT=[{"url": "https://www.google.com/travel/flights?q=Flights%20from%20{origin}%20to%20{destination}%20on%20{date}%20one%20way"}]
# USE_LIVE_ALTERNATIVES=1      # replace scenario options with live itineraries (breaks the scripted hidden rules)
# Open-Meteo needs no key.

# --- Runtime ----------------------------------------------------------------------
# SKYMENTOR_OFFLINE=1          # skip every network call (rehearsals, flaky wifi)
# CORS_ORIGINS=http://localhost:3000
